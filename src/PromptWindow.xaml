<Window x:Class="ProjectDock.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="344"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True">
    <Border Margin="12"
            Padding="18"
            CornerRadius="14"
            Background="#FF111319"
            BorderBrush="#FF2B303B"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.5" Color="#FF000000" />
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" Foreground="#FFF2F5FA" />

            <Border Margin="0,12,0,0"
                    Padding="10,7"
                    CornerRadius="8"
                    Background="#FF1B2029"
                    BorderBrush="#FF2E3440"
                    BorderThickness="1">
                <TextBox x:Name="ValueBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#FFF2F5FA"
                         CaretBrush="White"
                         FontSize="12.5" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="取消"
                        Width="72"
                        Height="30"
                        Margin="0,0,8,0"
                        Style="{StaticResource IconButton}"
                        FontSize="12"
                        Click="OnCancelClick" />
                <Button Content="确定"
                        Width="72"
                        Height="30"
                        Style="{StaticResource PrimaryButton}"
                        Click="OnOkClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
