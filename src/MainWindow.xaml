<Window x:Class="ProjectDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProjectDock"
        Width="404"
        Height="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowActivated="True"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid>
    <Border x:Name="Shell"
            Margin="12"
            CornerRadius="16"
            Background="#F2111319"
            BorderBrush="#FF2B303B"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Direction="270" Opacity="0.55" Color="#FF000000" />
        </Border.Effect>

        <DockPanel LastChildFill="True">
            <Grid DockPanel.Dock="Top" Margin="16,16,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="项目分组" FontSize="15" FontWeight="SemiBold" Foreground="#FFF2F5FA" />
                    <TextBlock x:Name="HintText"
                               Text="按项目整理正在运行的窗口 · 右键可移动分组"
                               FontSize="10.5"
                               Foreground="#FF7C8496"
                               Margin="0,3,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Width="28"
                        Height="28"
                        Margin="0,0,6,0"
                        Content="&#xE765;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="13"
                        Style="{StaticResource IconButton}"
                        Click="OnHotkeyClick"
                        ToolTip="设置呼出快捷键" />

                <Button Grid.Column="2"
                        Width="28"
                        Height="28"
                        Content="+"
                        FontSize="15"
                        Style="{StaticResource IconButton}"
                        Click="OnAddGroupClick"
                        ToolTip="新建项目组" />
            </Grid>

            <Border x:Name="NewGroupBar"
                    DockPanel.Dock="Top"
                    Margin="16,0,16,10"
                    Padding="10,7"
                    CornerRadius="8"
                    Background="#FF1B2029"
                    BorderBrush="#FF2E3440"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <TextBox x:Name="NewGroupText"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#FFF2F5FA"
                         CaretBrush="White"
                         FontSize="12"
                         KeyDown="OnNewGroupKeyDown"
                         LostFocus="OnNewGroupLostFocus" />
            </Border>

            <TextBlock x:Name="EmptyHint"
                       DockPanel.Dock="Bottom"
                       Text="没有可展示的窗口"
                       FontSize="11"
                       Foreground="#FF5E6577"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,10"
                       Visibility="Collapsed" />

            <ScrollViewer
                          Margin="12,0,10,10"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="GroupList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,4,8"
                                    CornerRadius="12"
                                    Background="{Binding CardBrush}"
                                    BorderBrush="{Binding BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="12,10,10,7"
                                          Background="Transparent"
                                          PreviewMouseLeftButtonDown="OnGroupHeaderPreviewMouseDown"
                                          MouseMove="OnGroupHeaderMouseMove"
                                          MouseLeftButtonUp="OnGroupHeaderClick"
                                          MouseRightButtonUp="OnGroupRightClick">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="3"
                                                Height="15"
                                                CornerRadius="2"
                                                Background="{Binding AccentBrush}"
                                                VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFE8ECF4"
                                                   Margin="9,0,8,0"
                                                   VerticalAlignment="Center" />

                                        <Border Grid.Column="2"
                                                Background="{Binding CountBackground}"
                                                CornerRadius="8"
                                                Padding="7,2"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding BadgeVisibility}">
                                            <TextBlock Text="{Binding CountText}"
                                                       FontSize="10"
                                                       Foreground="{Binding AccentBrush}" />
                                        </Border>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Chevron}"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="8"
                                                   Foreground="#FF7C8496"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Windows}"
                                                  Margin="8,0,8,8"
                                                  Visibility="{Binding ContentVisibility}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8"
                                                        Padding="8,7"
                                                        ToolTip="{Binding ToolTipText}"
                                                        PreviewMouseLeftButtonDown="OnWindowPreviewMouseDown"
                                                        MouseMove="OnWindowMouseMove"
                                                        MouseLeftButtonUp="OnWindowClick"
                                                        MouseRightButtonUp="OnWindowRightClick">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#1AFFFFFF" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="24" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Image Source="{Binding Icon}"
                                                               Width="18"
                                                               Height="18"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Title}"
                                                                   FontSize="12"
                                                                   Foreground="#FFDCE1EC"
                                                                   VerticalAlignment="Center"
                                                                   Margin="2,0,8,0" />

                                                        <TextBlock Grid.Column="2"
                                                                   Text="&#xE711;"
                                                                   Tag="close"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="9"
                                                                   Foreground="#FF586072"
                                                                   Padding="4,2"
                                                                   Cursor="Hand"
                                                                   VerticalAlignment="Center"
                                                                   MouseLeftButtonDown="OnCloseWindowClick" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </DockPanel>
    </Border>

    <Popup x:Name="MenuPopup"
           StaysOpen="False"
           AllowsTransparency="True"
           Placement="Mouse"
           PopupAnimation="Fade">
        <Border Margin="6"
                Padding="4"
                CornerRadius="10"
                Background="#FF1C212B"
                BorderBrush="#FF333A48"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.5" Color="#FF000000" />
            </Border.Effect>
            <StackPanel x:Name="MenuItems" MinWidth="156" />
        </Border>
    </Popup>

    <Border x:Name="DragGhost"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Panel.ZIndex="200"
            Padding="10,8"
            CornerRadius="9"
            Background="#F2232935"
            BorderBrush="#FF3D4657"
            BorderThickness="1"
            IsHitTestVisible="False"
            Visibility="Collapsed">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.5" Color="#FF000000" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Image x:Name="GhostIcon"
                   Width="16"
                   Height="16"
                   Margin="0,0,8,0"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock x:Name="GhostText"
                       FontSize="12"
                       Foreground="#FFE8ECF4"
                       MaxWidth="240"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
    </Grid>
</Window>
